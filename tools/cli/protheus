#!/bin/bash
set -e

# Resolve paths
CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="$(dirname "$CLI_DIR")"
PROJECT_ROOT="$(dirname "$TOOLS_DIR")"
ENV_ROOT="${PROJECT_ROOT}/environments"

# Helpher functions
help() {
    echo "Usage: protheus <command> [args]"
    echo ""
    echo "Commands:"
    echo "  init <env_name>       Create a new environment (wizard)"
    echo "  generate <env_name>   Generate configuration (docker-compose.yml or kubernetes.yaml)"
    echo "    --target <docker|k8s> (default: docker)"
    echo "  up <env_name>         Start the environment (Docker Compose)"
    echo "  down <env_name>       Stop the environment"
    echo "  shell <env_name> <svc> Open a shell in a service container"
    echo "  logs <env_name> <svc>  View logs"
    echo "  db create <env_name>   Create initial empty database"
    echo "  db restore <env_name>  Restore verified TOTVS backup (Dump)"
    echo ""
    exit 1
}

if [ -z "$1" ]; then
    help
fi

CMD="$1"
ENV_NAME="$2"

if [ "$CMD" == "init" ]; then
    if [ -z "$ENV_NAME" ]; then
        echo "Error: Environment name required."
        exit 1
    fi
    # Call the setup wizard
    bash "${CLI_DIR}/setup_wizard.sh" create "$ENV_NAME"
    exit 0
fi

if [ "$CMD" == "db" ]; then
    # For db command, syntax is: protheus db <action> <env_name>
    SUB_CMD="$2"
    ENV_NAME="$3"

    if [ -z "$ENV_NAME" ]; then
         echo "Usage: protheus db <create|restore> <env_name>"
         exit 1
    fi
     # Pass through, logic handled in case later
fi

if [ -z "$ENV_NAME" ]; then
    echo "Error: Environment name required for command '$CMD'."
    exit 1
fi

ENV_DIR="${ENV_ROOT}/${ENV_NAME}"
if [ ! -d "$ENV_DIR" ]; then
    echo "Error: Environment '$ENV_NAME' not found at $ENV_DIR"
    exit 1
fi

case "$CMD" in
    generate)
        TARGET="docker"
        if [ "$3" == "--target" ] && [ -n "$4" ]; then
            TARGET="$4"
        fi

        if [ "$TARGET" == "docker" ]; then
            bash "${TOOLS_DIR}/generators/generate_docker.sh" "$ENV_NAME"
        elif [ "$TARGET" == "k8s" ]; then
            if [ -f "${TOOLS_DIR}/generators/generate_k8s.sh" ]; then
                bash "${TOOLS_DIR}/generators/generate_k8s.sh" "$ENV_NAME"
            else
                echo "Error: Kubernetes generator not implemented yet."
                exit 1
            fi
        else
            echo "Error: Unknown target '$TARGET'"
            exit 1
        fi
        ;;
    up)
        cd "$ENV_DIR"
        docker compose up -d
        ;;
    down)
        cd "$ENV_DIR"
        docker compose down
        ;;
    restart)
        cd "$ENV_DIR"
        docker compose restart
        ;;
    ps)
        cd "$ENV_DIR"
        docker compose ps
        ;;
    logs)
        SVC="${3:-}"
        cd "$ENV_DIR"
        docker compose logs -f "$SVC"
        ;;
    shell)
        SVC="$3"
        if [ -z "$SVC" ]; then
             echo "Error: Service name required (e.g., protheus, dbaccess, oracle19, postgres16)"
             exit 1
        fi
        cd "$ENV_DIR"
        # Try to find the container name
        # docker compose exec requires service name
        docker compose exec "$SVC" bash || docker compose exec "$SVC" sh
        ;;
    db)
        ACTION="$SUB_CMD"
        if [ -z "$ACTION" ]; then
            echo "Usage: protheus db <create|restore> <env_name>"
            exit 1
        fi

        # Load config to determine database type
        CONFIG_FILE="${ENV_DIR}/config.env"
        if [ ! -f "$CONFIG_FILE" ]; then
            echo "Error: Config file not found at $CONFIG_FILE"
            exit 1
        fi
        source "$CONFIG_FILE"

        # Determine DB Service and Scripts
        DB_SVC=""
        SCRIPT_CREATE=""
        SCRIPT_RESTORE=""

        case "${BANCO_DE_DADOS}" in
            postgres*)
                DB_SVC="${BANCO_DE_DADOS}" # e.g. postgres15
                SCRIPT_CREATE="/local/tools/database/postgres_create_database.sh"
                SCRIPT_RESTORE="/local/tools/database/postgres_pgrestore.sh"
                ;;
            oracle*)
                DB_SVC="oracle19" # usually named oracle19 in compose
                SCRIPT_CREATE="/local/tools/database/oracle_create_database.sh"
                SCRIPT_RESTORE="/local/tools/database/oracle_impdp.sh"
                ;;
            mssql*)
                DB_SVC="${BANCO_DE_DADOS}" # e.g. mssql2022
                SCRIPT_CREATE="/local/tools/database/mssql_create_database.sh"
                SCRIPT_RESTORE="/local/tools/database/mssql_restore_database.sh"
                ;;
            *)
                echo "Error: Unknown database type '${BANCO_DE_DADOS}'"
                exit 1
                ;;
        esac

        cd "$ENV_DIR"

        case "$ACTION" in
            create)
                echo ">> Creating Database for $ENV_NAME ($BANCO_DE_DADOS)..."
                echo ">> Running: $SCRIPT_CREATE inside $DB_SVC"
                docker compose exec "$DB_SVC" bash "$SCRIPT_CREATE"
                ;;
            restore)
                echo ">> Restoring Database for $ENV_NAME ($BANCO_DE_DADOS)..."
                echo ">> Running: $SCRIPT_RESTORE inside $DB_SVC"
                docker compose exec "$DB_SVC" bash "$SCRIPT_RESTORE"
                ;;
            *)
                echo "Error: Unknown db action '$ACTION'. Use 'create' or 'restore'."
                exit 1
                ;;
        esac
        ;;
    *)
        help
        ;;
esac
