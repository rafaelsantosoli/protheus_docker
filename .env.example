# =============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PROTHEUS DOCKER
# =============================================================================
# Este arquivo serve como template para criação de ambientes.
# Copie este arquivo para environments/<nome_ambiente>/config.env e ajuste os valores.
#
# Exemplo:
#   cp .env.example environments/meu_ambiente/config.env
#
# =============================================================================

# -----------------------------------------------------------------------------
# RELEASE DO PROTHEUS
# -----------------------------------------------------------------------------
# Versão do Protheus a ser utilizada (ex: 12.1.2510, 12.1.2310, 12.1.33)
RELEASE=12.1.2510

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# Opções disponíveis:
#   - postgres15    : PostgreSQL 15
#   - postgres16    : PostgreSQL 16
#   - mssql2019     : Microsoft SQL Server 2019
#   - mssql2022     : Microsoft SQL Server 2022
#   - oracle19      : Oracle Database 19c
BANCO_DE_DADOS=postgres16

# -----------------------------------------------------------------------------
# EXPEDIÇÃO E ANIMAL
# -----------------------------------------------------------------------------
# Expedição do Protheus (ex: latest, 0000001, 0000002)
EXPEDICAO=latest

# Animal da expedição (usado para construir URL de download)
# Exemplos: panthera_onca, harpia, etc.
ANIMAL=panthera_onca

# -----------------------------------------------------------------------------
# IDIOMA
# -----------------------------------------------------------------------------
# Idioma da instalação
# Opções: bra (Brasil), esp (Espanhol), eng (Inglês), por (Português)
IDIOMA=bra

# -----------------------------------------------------------------------------
# RPO E DATABASE
# -----------------------------------------------------------------------------
# Nome do arquivo RPO (geralmente tttm120.rpo ou ttfm120.rpo)
RPO_FILE=tttm120.rpo

# Arquivo de banco de dados (ZIP) a ser baixado
# Exemplos: postgresql.zip, sqlserver.zip, oracle.zip
DATABASE_FILE=postgresql.zip

# -----------------------------------------------------------------------------
# TIPO DE INSTALAÇÃO
# -----------------------------------------------------------------------------
# Tipo de congelada a ser instalada
# Opções: exp_com_dic, exp_sem_dic
TIPO_CONGELADA=exp_com_dic

# Tipo de Protheus
# Opções: padrao, sdk
TIPO_PROTHEUS=padrao

# -----------------------------------------------------------------------------
# DOCKER COMPOSE
# -----------------------------------------------------------------------------
# Nome do projeto Docker Compose (deve ser único para evitar conflitos)
# Recomendação: use um nome descritivo do ambiente (ex: pg_dev, oracle_prod)
COMPOSE_PROJECT_NAME=meu_ambiente

# -----------------------------------------------------------------------------
# SERVIDOR DE LICENÇAS (OPCIONAL)
# -----------------------------------------------------------------------------
# Se você possui um servidor de licenças, configure aqui.
# Caso contrário, deixe comentado ou vazio para usar localhost.
#
# LICENSE_SERVER=192.168.1.100
# LICENSE_PORT=5555

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. Após criar o arquivo config.env, execute: ./create.sh <nome_ambiente>
# 2. Para atualizar um ambiente existente: ./update.sh <nome_ambiente>
# 3. As senhas padrão são definidas no generate.sh e podem ser alteradas lá
# 4. Volumes Docker são criados automaticamente para persistência de dados
# 5. Cada ambiente é isolado e pode ter configurações diferentes
# =============================================================================
